# IRM Data Import Page Translations (German - Germany)

data-import-header-title = Datenimport
data-import-header-description = Importieren Sie Daten aus CSV- oder Excel-Dateien mit KI-gestützter Feldzuordnung. Laden Sie Ihre Datei hoch, überprüfen Sie die vorgeschlagenen Zuordnungen und importieren Sie.
data-import-search-placeholder = Importtypen suchen...

# Fehlerzustand, wenn der InvestmentGroup-Katalog nicht geladen werden kann
data-import-load-error-title = Investitionsgruppen konnten nicht geladen werden
data-import-load-error-description = Der Investitionsgruppen-Katalog konnte nicht erreicht werden. Ohne ihn können Importe nicht zuverlässig gesendet werden.
data-import-load-error-retry = Erneut versuchen

# Single-entity import cards
card-lead-title = Leads importieren
card-lead-description = Importieren Sie Investment-Leads aus CSV oder Excel mit Unternehmensinformationen, Investitionsdetails, Finanzdaten und Objektinformationen. Die KI-gestützte Feldzuordnung hilft Ihnen, Ihre Daten schnell zuzuordnen.
card-lead-button = Lead-Import starten

card-contact-title = Kontakte importieren
card-contact-description = Importieren Sie einzelne Kontakte aus CSV oder Excel mit persönlichen Informationen, Kontaktdetails und Sprachpräferenzen. Die KI erkennt und ordnet Felder automatisch zu.
card-contact-button = Kontakt-Import starten

card-account-title = Accounts importieren
card-account-description = Importieren Sie Firmenaccounts aus CSV oder Excel mit Organisationsdaten, Branchenangaben, Umsatzdaten und Kommunikationskanälen. KI-gestützte Zuordnung beschleunigt den Prozess.
card-account-button = Account-Import starten

card-opportunity-title = Opportunities importieren
card-opportunity-description = Importieren Sie Investment-Opportunities aus CSV oder Excel mit Pipeline-Phasen, Prognosen, Deal-Informationen und investmentspezifischen Feldern. KI-gestützte Zuordnung beschleunigt den Prozess.
card-opportunity-button = Opportunity-Import starten

# Multi-entry investments card
card-investments-title = Investitionen importieren
card-investments-description = Importieren Sie Investitionsdaten aus CSV- oder Excel-Dateien mit KI-gestützter Feldzuordnung.

# Multi-entry investment reports card
card-investment-reports-title = Investitionsberichte importieren
card-investment-reports-description = Importieren Sie Investitionsberichtsdaten aus CSV- oder Excel-Dateien mit KI-gestützter Feldzuordnung.
