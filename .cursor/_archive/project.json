{
  "name": "gravity-business-apps",
  "version": "1.0.0",
  "rules": {
    "componentLocation": "src/business-apps",
    "propsInterface": "BusinessAppContextProps",
    "contextUsage": {
      "accessToken": "from BusinessAppContextProps",
      "userInfo": "from BusinessAppContextProps",
      "employeeId": "from BusinessAppContextProps.userInfo.employeeDetails.employeeId",
      "structureId": "from BusinessAppContextProps.activeStructureId"
    },
    "exports": {
      "apps": "named export and default export in index.ts",
      "forms": "named export and default export in index.ts"
    }
  }
} 