{
  "conventions": {
    "folders": {
      "pattern": "kebab-case",
      "examples": ["src/business-apps/fin/expenses/personal-expenses"]
    },
    "files": {
      "pascalCase": {
        "pattern": "^[A-Z][a-zA-Z0-9]*\\.tsx$",
        "types": ["apps", "forms", "components"],
        "examples": ["PersonalExpenses.tsx", "EmployeeRecord.tsx"]
      },
      "camelCase": {
        "pattern": "^[a-z][a-zA-Z0-9]*\\.ts$",
        "types": ["index.ts", "hooks", "utils", "types", "functions"],
        "examples": ["index.ts", "useEmployeeData.ts"]
      }
    }
  }
} 