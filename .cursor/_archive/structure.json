{
  "root": "src/business-apps",
  "structure": {
    "module": {
      "pattern": "<module>",
      "examples": ["hr", "fin", "crm"]
    },
    "subModule": {
      "pattern": "<module>/<sub-module>",
      "examples": ["hr/core", "fin/expenses"]
    },
    "apps": {
      "pattern": "<module>/<sub-module>/apps/<app-name>",
      "required": ["AppName.tsx", "index.ts"],
      "optional": ["components", "hooks", "types", "utils"]
    },
    "forms": {
      "pattern": "<module>/<sub-module>/forms/<form-name>",
      "required": ["FormName.tsx", "index.ts"],
      "optional": ["components", "hooks", "types", "utils"]
    }
  }
} 