# Snyk (https://snyk.io) policy file
# This file defines ignores for false positive security findings
#
# These XSS findings are false positives because all image/video src attributes
# are sanitized using sanitizeImageUrl() or sanitizeMediaUrl() functions that:
# - Whitelist safe protocols: https://, http://, data:image/, data:video/, blob://
# - Allow relative paths: /, ./, ../
# - Block dangerous protocols: javascript:, data:text/html, vbscript:, etc.
# - Return empty string for any URL that doesn't match the whitelist
#
# The sanitization is applied at render time AND as a conditional (&&) so
# elements won't render at all if the URL is invalid.

version: v1.25.0

exclude:
  code:
    - src/business-apps/platform/apps/slide-apps/components/BrandSettingsDialog.tsx
    - src/business-apps/platform/apps/slide-apps/components/PropertyPanel.tsx
    - src/business-apps/platform/apps/slide-apps/components/SlideEditor.tsx
    - src/business-apps/platform/apps/slide-apps/components/SlideCanvas.tsx
    - src/business-apps/platform/apps/slide-apps/components/SlideExportRenderer.tsx
    - src/business-apps/platform/apps/slide-apps/components/TemplateCard.tsx

patch: {}
