<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>9f2a1c2b-6b7b-4d6d-8c5b-4eab64c2f3d1</Id>
  <Version>0.1.0.3</Version>
  <ProviderName>NEWWORK</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="NEWWORK Every Desktop"/>
  <Description DefaultValue="Send the current email to NEWWORK Every Desktop."/>

  <!-- Match the structure of the known-working add-in -->
  <IconUrl DefaultValue="https://res-1.cdn.office.net/files/fabric/assets/brand-icons/product/png/outlook_32x1.png"/>
  <HighResolutionIconUrl DefaultValue="https://res-1.cdn.office.net/files/fabric/assets/brand-icons/product/png/outlook_96x1.png"/>
  <SupportUrl DefaultValue="https://product-report.vercel.app/"/>

  <AppDomains>
    <AppDomain>https://product-report.vercel.app</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <!-- Keep base requirement low; command surface requirements are in VersionOverrides -->
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://product-report.vercel.app/outlook-addin/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <!-- IMPORTANT: Nested VersionOverrides (V1_0 wrapper + V1_1 content) -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.3">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="msgReadGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="msgReadOpenPaneButton">
                    <Label resid="TaskpaneButton.Label"/>
                    <Supertip>
                      <Title resid="TaskpaneButton.Label"/>
                      <Description resid="TaskpaneButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://res-1.cdn.office.net/files/fabric/assets/brand-icons/product/png/outlook_16x1.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://res-1.cdn.office.net/files/fabric/assets/brand-icons/product/png/outlook_32x1.png"/>
        <!-- 80px icon isn't published; 96px works as high-res in practice -->
        <bt:Image id="Icon.80x80" DefaultValue="https://res-1.cdn.office.net/files/fabric/assets/brand-icons/product/png/outlook_96x1.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://product-report.vercel.app/outlook-addin/commands.html"/>
          <bt:Url id="Taskpane.Url" DefaultValue="https://product-report.vercel.app/outlook-addin/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="NEWWORK"/>
          <bt:String id="TaskpaneButton.Label" DefaultValue="Send to Desktop"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Send this email to NEWWORK Every Desktop."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>

