@newwork:registry=https://pkgs.dev.azure.com/newwork-team/_packaging/az_packages_registry/npm/registry/
always-auth=true
//pkgs.dev.azure.com/newwork-team/_packaging/az_packages_registry/npm/registry/:username=AzureDevOps
//pkgs.dev.azure.com/newwork-team/_packaging/az_packages_registry/npm/registry/:_password="QUZXQm5LYUs4QTdpcU56R0JhWTQ4aXVSNUFYOHdab2h0MU5rNVpOZHhWalpNZ2RMdWVxY0pRUUo5OUNEQUNBQUFBQW9va3ZvQUFBU0FaRE8zamlU"
//pkgs.dev.azure.com/newwork-team/_packaging/az_packages_registry/npm/registry/:email=dprekrat@newwork.com
engine-strict=true

# Lockfile behavior
# It forces everyone to produce the exact same lockfile structure.
package-lock=true
lockfile-version=3

# Peer dependency behavior
# Keeping these explicit is good for avoiding churn between npm versions.
legacy-peer-deps=false
strict-peer-deps=false

# Tree/hoisting behavior
# 'hoisted' is the standard npm behavior. 
install-strategy=hoisted
