# =============================================================================
# Tooling / commit hooks (no secrets in example; set locally)
# =============================================================================
# OpenAI token for czg (commitizen)
CZ_OPENAI_API_KEY=<openai-api-key>

# =============================================================================
# Azure Storage – Dev (publishing screens, build scripts)
# =============================================================================
AZURE_STORAGE_ACCOUNT=your-azure-storage-account
AZURE_STORAGE_SAS_TOKEN=<azure-storage-sas-token>
AZURE_BLOB_CONTAINER_NAME=screens

# =============================================================================
# Azure Storage – Prod (reading production screens)
# =============================================================================
AZURE_STORAGE_ACCOUNT_PROD=your-azure-storage-account-prod
AZURE_STORAGE_SAS_TOKEN_PROD=<azure-storage-sas-token-prod>
AZURE_BLOB_CONTAINER_NAME_PROD=screens

# =============================================================================
# Azure Storage – Frontend (Resource Manager / NEXT_PUBLIC)
# =============================================================================
NEXT_PUBLIC_AZURE_STORAGE_ACCOUNT_DEV=your-azure-storage-account
NEXT_PUBLIC_AZURE_STORAGE_SAS_TOKEN_DEV=<azure-storage-sas-token-dev>
NEXT_PUBLIC_AZURE_STORAGE_ACCOUNT_PROD=your-azure-storage-account-prod
NEXT_PUBLIC_AZURE_STORAGE_SAS_TOKEN_PROD=<azure-storage-sas-token-prod>
NEXT_PUBLIC_AZURE_BLOB_CONTAINER_NAME=screens

# =============================================================================
# Org chart / IDE (structure context)
# =============================================================================
IDE_ACTIVE_STRUCTURE_ID=<structure-id>

# =============================================================================
# Keycloak / OAuth (backend)
# =============================================================================
OAUTH_CLIENT_ID=api-client
OAUTH_CLIENT_SECRET=<oauth-client-secret>
OAUTH_URL=https://keycloak-dev.newwork.com
OAUTH_REALM=newwork

# =============================================================================
# Keycloak / OIDC (frontend)
# =============================================================================
NEXT_PUBLIC_OIDC_CLIENT_ID=gravity-platform
NEXT_PUBLIC_OIDC_URL=https://keycloak-dev.newwork.com
NEXT_PUBLIC_OIDC_REALM=newwork

# =============================================================================
# Tenant / base URLs (adjust for dev/stage/prod)
# =============================================================================
NEXT_PUBLIC_BASE_URL=https://newwork-dev.newwork.com
NEXT_PUBLIC_FEATURE_HUB_API=https://features-dev.newwork.com
NEXT_PUBLIC_USER_MANAGEMENT_API=https://dev.newwork.com/usermanagement/api/v1

# =============================================================================
# Feature Hub
# =============================================================================
NEXT_PUBLIC_FEATURE_HUB_API_KEY=<feature-hub-api-key>
NEXT_PUBLIC_FEATURE_HUB_TENANT=admin

# =============================================================================
# API endpoints (derived from base URL where possible)
