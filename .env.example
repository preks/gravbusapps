# OpenAI token for czg
CZ_OPENAI_API_KEY=your-openai-api-key-here

# Azure Storage Account Name for publishing screens
AZURE_STORAGE_ACCOUNT=your-azure-storage-account
# Will be used for authentication, ensure the SAS token has write permissions to the 'screens' container.
AZURE_STORAGE_SAS_TOKEN=your-azure-storage-sas-token
# Azure blob container where to place screens
AZURE_BLOB_CONTAINER_NAME=screens

# Active structure ID for org chart related queries (defaults to Dev)
IDE_ACTIVE_STRUCTURE_ID="your-structure-id-here"

# Keycloak config
OAUTH_CLIENT_ID=api-client
OAUTH_CLIENT_SECRET=your-oauth-client-secret
OAUTH_URL=https://keycloak-dev.newwork.com
OAUTH_REALM=newwork

NEXT_PUBLIC_OIDC_CLIENT_ID=gravity-platform
NEXT_PUBLIC_OIDC_URL=https://keycloak-dev.newwork.com
NEXT_PUBLIC_OIDC_REALM=newwork

# Tenant URLs
NEXT_PUBLIC_BASE_URL="https://newwork-dev.newwork.com"
NEXT_PUBLIC_API_SERVER="https://newwork-dev.newwork.com"
NEXT_PUBLIC_FEATURE_HUB_API="https://features-dev.newwork.com"
NEXT_PUBLIC_ORGCHART_API_URL="https://newwork-dev.newwork.com"
NEXT_PUBLIC_USER_MANAGEMENT_API="https://dev.newwork.com/usermanagement/api/v1"

NEXT_PUBLIC_GRAPHQL_ENDPOINT_NEWWORK="${NEXT_PUBLIC_BASE_URL}/v1/graphql"
NEXT_PUBLIC_CATALOG_API="${NEXT_PUBLIC_BASE_URL}/catalog-manager"
NEXT_PUBLIC_FLOW_REGISTRY_SERVICE_API="${NEXT_PUBLIC_BASE_URL}/flow-registry/api/v1"
NEXT_PUBLIC_PERMISSIONS_API="${NEXT_PUBLIC_BASE_URL}/authorization/api/v1"
NEXT_PUBLIC_FILE_SERVICE_ENDPOINT="${NEXT_PUBLIC_BASE_URL}/files/api/v1"
NEXT_PUBLIC_KOGITO_PROCESSES_ENDPOINT="${NEXT_PUBLIC_BASE_URL}/processes"
NEXT_PUBLIC_GRAPHQL_ENDPOINT_DATA_INDEX="${NEXT_PUBLIC_BASE_URL}/data-index/graphql"
NEXT_PUBLIC_REST_ENDPOINT_ORGCHART="${NEXT_PUBLIC_API_SERVER}/orgchart/api/v1"
NEXT_PUBLIC_GRAPHQL_ENDPOINT_ORGCHART="${NEXT_PUBLIC_BASE_URL}/orgchart/api/v1"
NEXT_PUBLIC_CLOUD_PROCESS_INSTANCES="https://process-console.newwork.com/ProcessInstances"
NEXT_PUBLIC_LOWCODER_API_BASE_URL="https://lowcoder-dev.newwork.com"
NEXT_PUBLIC_GLOBAL_SEARCH_API="${NEXT_PUBLIC_BASE_URL}/search/api/v1"
NEXT_PUBLIC_CHAT_REST_API="https://chat-newwork-dev.newwork.com"
NEXT_PUBLIC_FLOW_MANAGER_ENDPOINT="${NEXT_PUBLIC_BASE_URL}/flow-manager/api/v1"
NEXT_PUBLIC_FLOW_CONFIGURATION_SERVICE_ENDPOINT="${NEXT_PUBLIC_BASE_URL}/configuration/api/v1"
NEXT_PUBLIC_FLOW_METRICS_ENDPOINT="${NEXT_PUBLIC_BASE_URL}/flow-metrics/api/v1"
NEXT_PUBLIC_NAVIGATION_SERVICE_API="${NEXT_PUBLIC_BASE_URL}/navigation/api/v1"
NEXT_PUBLIC_SCREEN_MANAGEMENT_SERVICE_API="${NEXT_PUBLIC_BASE_URL}/screen-management/api/v1"

NEXT_PUBLIC_FEATURE_HUB_API_KEY="your-feature-hub-api-key"
NEXT_PUBLIC_FEATURE_HUB_TENANT="admin"

# Business Flows API Configuration
NEXT_PUBLIC_CUSTOM_FLOW_ENGINE_API_URL="${NEXT_PUBLIC_BASE_URL}/flow-engine/api/v1"

# Chat service
NEXT_PUBLIC_CHAT_API="${NEXT_PUBLIC_CHAT_REST_API}/api/v1"
NEXT_PUBLIC_CHAT_WEB_SOCKET="${NEXT_PUBLIC_CHAT_REST_API}/chat-service"

# Prompt manager
NEXT_PUBLIC_PROMPT_MANAGER_API_URL="${NEXT_PUBLIC_BASE_URL}/prompt-manager"

# Document Service
NEXT_PUBLIC_DOCUMENT_SERVICE_URL="${NEXT_PUBLIC_BASE_URL}/document/api/v1"
