    "lucide-react": "^0.511.0",
    "mammoth": "^1.11.0",
    "pdfkit": "^0.17.2",
    "react": "^18.3.1",
    "react-diff-viewer-continued": "^3.4.0",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.5.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-phone-number-input": "^3.4.14",
    "react-quill": "^2.0.0",
