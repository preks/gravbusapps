    "@eslint/js": "^9.25.0",
    "@newwork/commitlint-config": "^0.1.0",
    "@newwork/cursor-rules": "latest",
    "@newwork/cz-config": "^0.2.1",
    "@newwork/eslint-config": "^0.4.1",
    "@newwork/git-hooks": "^0.2.0",
