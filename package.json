{
  "name": "gravity-business-apps",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "cross-env PROJECT_ROOT_DIR=$INIT_CWD vite build",
    "build:prod": "cross-env PROJECT_ROOT_DIR=$INIT_CWD VITE_BUILD_FOR_DEPLOYMENT=true vite build --mode production",
    "publish:screen": "node ./scripts/publish-dev-screen.js",
    "publish:prod:screens": "npm run build:prod && node ./scripts/publish-prod-screen.js",
    "serve": "vite serve --port 5001 --strictPort",
    "lint": "eslint ."
  },
  "dependencies": {
    "@newwork/gravity-ui-catalog": "7.8.5",
    "@remixicon/react": "^4.6.0",
    "@ant-design/icons": "^5.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/recharts": "^1.8.29",
    "antd": "^5.25.1",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.3.0",
    "zustand": "^5.0.4",
    "react-icons": "^4.6.0",
    "react-i18next": "15.5.1",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@azure/storage-blob": "^12.27.0",
    "@eslint/js": "^9.25.0",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@tailwindcss/vite": "^4.1.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "express": "^5.1.0",
    "glob": "^11.0.2",
    "globals": "^16.0.0",
    "http-server": "^14.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.6",
    "tw-animate-css": "^1.2.9",
    "vite": "^6.3.5",
    "webpack-manifest-plugin": "^5.0.1"
  }
}
