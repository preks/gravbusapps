{
  "name": "gravity-business-apps",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "npm install && npm run cleanup:logs && vite --port 3001 --strictPort",
    "cleanup:logs": "node ./scripts/utils/cleanup-old-logs.js",
    "build": "cross-env PROJECT_ROOT_DIR=$INIT_CWD VITE_BUILD_FOR_DEPLOYMENT=false NODE_ENV=production vite build",
    "build:batched": "node ./scripts/build-all-screens-batched.js",
    "build:prod": "cross-env PROJECT_ROOT_DIR=$INIT_CWD VITE_BUILD_FOR_DEPLOYMENT=false NODE_ENV=production vite build",
    "publish:screen": "node ./scripts/publish-dev-screen.js",
    "publish:all:screens": "node ./scripts/publish-all-screens.js",
    "publish:example": "node ./scripts/publish-dev-example.js",
    "publish:prod:screens": "npm run build:prod && node ./scripts/publish-prod-screens.js",
    "publish:prod:all": "node ./scripts/publish-all-prod-screens.js",
    "serve": "vite serve --port 5001 --strictPort",
    "proxy:conductor": "node ./scripts/conductor-proxy.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "newwork-git-hooks",
    "commit": "dotenvx run -- czg ai",
    "rules:sync": "cursor-rules sync",
    "rules:validate": "cursor-rules validate",
    "rules:diff": "cursor-rules diff",
    "postinstall": "cursor-rules sync --silent"
  },
  "dependencies": {
    "@ant-design/icons": "^5.0.0",
    "@codemirror/lang-javascript": "^6.2.4",
