{
  "name": "gravity-business-apps",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/start-dev-server.js",
    "sync:platform-assets": "node ./scripts/sync-platform-assets.mjs",
    "cleanup:logs": "node ./scripts/utils/cleanup-old-logs.js",
    "check:enterprise-ai-stack": "node ./scripts/check-enterprise-ai-stack.mjs",
    "setup:env": "node ./scripts/setup-env.js",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 PROJECT_ROOT_DIR=$INIT_CWD VITE_BUILD_FOR_DEPLOYMENT=false NODE_ENV=production vite build",
    "build:batched": "node ./scripts/build-all-screens-batched.js",
    "build:prod": "cross-env NODE_OPTIONS=--max-old-space-size=8192 PROJECT_ROOT_DIR=$INIT_CWD VITE_BUILD_FOR_DEPLOYMENT=false NODE_ENV=production vite build",
    "report:bundles": "node ./scripts/report-bundles.mjs",
    "publish:screen": "node ./scripts/publish-dev-screen.js",
    "register:resource-url": "node ./scripts/register-resource-url.js",
    "publish:space-hero-video": "node ./scripts/publish-space-hero-video.js",
    "publish:space-hub-video": "node ./scripts/publish-space-hub-video.js",
    "publish:newwork-main-video": "node ./scripts/publish-newwork-main-video.js",
    "publish:all:screens": "node ./scripts/publish-all-screens.js",
    "publish:example": "node ./scripts/publish-dev-example.js",
    "publish:prod:screens": "npm run build:prod && node ./scripts/publish-prod-screens.js",
    "publish:prod:all": "node ./scripts/publish-all-prod-screens.js",
    "preserve": "node ./scripts/sync-platform-assets.mjs",
    "serve": "vite serve --port 5001 --strictPort",
    "test": "jest --maxWorkers=50%",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --maxWorkers=50%",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:changed": "jest --onlyChanged --maxWorkers=50%",
    "test:hr": "jest src/business-apps/hr --maxWorkers=50%",
    "lint": "eslint .",
    "typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=7168 tsc --noEmit --pretty false",
    "typecheck:app": "cross-env NODE_OPTIONS=--max-old-space-size=7168 node ./scripts/typecheck-app.js",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "commit": "dotenvx run -- czg ai",
    "rules:sync": "cursor-rules sync",
    "rules:validate": "cursor-rules validate",
    "rules:diff": "cursor-rules diff",
    "preinstall": "node ./scripts/setup-env.js",
    "postinstall": "newwork-git-hooks && node scripts/patch-excalidraw-dynamic-imports.cjs"
  },
