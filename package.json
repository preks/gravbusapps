{
  "name": "gravity-business-apps",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm install && vite --port 5173 --strictPort",
    "build": "npm install && cross-env PROJECT_ROOT_DIR=$INIT_CWD vite build",
    "build:prod": "npm install && cross-env PROJECT_ROOT_DIR=$INIT_CWD VITE_BUILD_FOR_DEPLOYMENT=true vite build --mode production",
    "publish:screen": "node ./scripts/publish-dev-screen.js",
    "publish:prod:screens": "npm run build:prod && node ./scripts/publish-prod-screen.js",
    "serve": "vite serve --port 5001 --strictPort",
    "lint": "eslint .",
    "postinstall": "npm install @newwork/nw-design-system@latest"
  },
  "dependencies": {
    "@ant-design/charts": "^2.3.0",
    "@ant-design/icons": "^5.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@newwork/gravity-ui-catalog": "7.10.4",
    "@newwork/nw-design-system": "^0.0.1-57",
    "@remixicon/react": "^4.6.0",
    "antd": "^5.25.1",
    "clsx": "^2.1.1",
    "featurehub-javascript-client-sdk": "^1.4.0",
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.1.0",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.5.1",
    "react-icons": "^5.5.0",
    "recharts": "^2.15.3",
    "tailwind-merge": "^3.3.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@azure/storage-blob": "^12.27.0",
    "@dotenvx/dotenvx": "^1.45.1",
    "@eslint/js": "^9.25.0",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@tailwindcss/vite": "^4.1.6",
    "@types/node": "^24.0.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/react-router-dom": "^5.3.3",
    "@types/recharts": "^1.8.29",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "axios": "^1.8.4",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "express": "^5.1.0",
    "featurehub-react-sdk": "^1.2.1",
    "glob": "^11.0.2",
    "globals": "^16.0.0",
    "http-server": "^14.1.1",
    "postcss": "^8.5.5",
    "tw-animate-css": "^1.2.9",
    "uuid": "^10.0.0",
    "vite": "^6.3.5",
    "webpack-manifest-plugin": "^5.0.1",
    "yargs": "^17.7.2"
  }
}
